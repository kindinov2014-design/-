<audio id="ambientMusic" src="music.mp3" loop preload="none"></audio>

<script>
const revealObserver = new IntersectionObserver(entries=>{
  entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('visible');revealObserver.unobserve(entry.target)}})
},{threshold:.12});
document.querySelectorAll('.reveal').forEach(el=>revealObserver.observe(el));
document.querySelectorAll('.mode').forEach((card,index)=>{
  card.addEventListener('click',()=>{
    const names=['Vanilla','Альматор','Последний рассвет'];
    const texts=[
      'Vanilla — основной режим классического выживания. Он доступен; адрес подключения добавим после настройки сервера.',
      'Альматор находится в разработке. Здесь появятся описание карты, особенности и дата запуска.',
      'Последний рассвет — третий, отдельный режим EPICENTR. Он находится в разработке; его история и правила будут относиться только к этому игровому миру.'
    ];
    showModal(names[index],texts[index]);
  });
});
document.querySelectorAll('nav a[href^="#"]').forEach(a=>a.addEventListener('click',()=>{
  document.querySelectorAll('nav a').forEach(x=>x.classList.remove('active'));a.classList.add('active');
}));
</script>

<script>
const ambientMusic=document.getElementById('ambientMusic');
const musicToggle=document.getElementById('musicToggle');
const musicPanel=document.getElementById('musicPanel');
const musicState=document.getElementById('musicState');
musicToggle.addEventListener('click',async()=>{
  if(ambientMusic.paused){
    try{
      await ambientMusic.play();
      musicPanel.classList.add('playing');
      musicToggle.textContent='Ⅱ';
      musicToggle.setAttribute('aria-label','Выключить музыку');
      musicToggle.title='Выключить музыку';
      musicState.textContent='АТМОСФЕРА ВКЛЮЧЕНА';
    }catch(error){
      musicState.textContent='ДОБАВЬТЕ ФАЙЛ music.mp3';
      showModal('Фоновая музыка','Положи спокойный аудиофайл с названием music.mp3 в ту же папку, где находится index.html. Затем обнови страницу и нажми кнопку музыки.');
    }
  }else{
    ambientMusic.pause();
    musicPanel.classList.remove('playing');
    musicToggle.textContent='♫';
    musicToggle.setAttribute('aria-label','Включить музыку');
    musicToggle.title='Включить музыку';
    musicState.textContent='МУЗЫКА ВЫКЛЮЧЕНА';
  }
});


<script>
const SERVER_IP = 'epicenter-WOM2.aternos.me:28270';
function copyServerIP(){
  if(navigator.clipboard && window.isSecureContext){
    navigator.clipboard.writeText(SERVER_IP).then(()=>showToast('IP скопирован: '+SERVER_IP)).catch(()=>showToast(SERVER_IP));
  }else{
    const field=document.createElement('textarea');
    field.value=SERVER_IP;field.style.position='fixed';field.style.opacity='0';
    document.body.appendChild(field);field.select();
    try{document.execCommand('copy');showToast('IP скопирован: '+SERVER_IP);}
    catch(e){showToast(SERVER_IP);}
    field.remove();
  }
}
</script>
</script>
